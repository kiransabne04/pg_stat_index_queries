SELECT left(query, 40) AS query, note, uses_index_now, uses_index_after
  FROM index_deps.index_drop_impact('o_c_idx')
 WHERE query LIKE '%interval%' OR query LIKE 'PREPARE q8%'
 ORDER BY query;
                  query                   |              note              | uses_index_now | uses_index_after 
------------------------------------------+--------------------------------+----------------+------------------
